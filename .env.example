# =============================================================================
# Vitalio — Variables d'environnement (racine du dépôt)
# =============================================================================
# Ce fichier est un modèle global pour le développement local.
#
# Recommandation :
#   • Backend  → copier back/.env.example vers back/.env (source principale)
#   • Frontend → copier front/vitalio/.env.example vers front/vitalio/.env
#
# L'API Flask charge les variables dans cet ordre (config.py) :
#   1. back/.env
#   2. .env du répertoire courant
#   3. .env à la racine (ce fichier, si copié en .env)
#
# Ne jamais committer de fichier .env contenant des secrets.
# =============================================================================

# --- Frontend (Vite) — voir front/vitalio/.env.example ---
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
VITE_API_URL=http://localhost:5000

# --- Backend Auth0 ---
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_IDENTITY_DB=Vitalio_Identity
MONGODB_MEDICAL_DB=Vitalio_Medical

# --- MQTT (broker local via docker compose dans back/) ---
MQTT_BROKER=localhost
MQTT_PORT=8883
MQTT_USERNAME=vitalio
MQTT_PASSWORD=change-me

# --- Seed dev (optionnel) ---
# SEED_USER_ID_AUTH=auth0|xxxxxxxx
# SEED_DEVICE_ID=SIM-ESP32-001

# --- Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=vapid_private.pem

# --- URLs ---
FRONTEND_URL=http://localhost:5173
