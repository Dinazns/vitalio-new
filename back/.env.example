# =============================================================================
# Vitalio - Backend (Flask API, MQTT, MongoDB)
# =============================================================================
# Copier ce fichier vers back/.env et renseigner les valeurs.
# L'API charge en priorité back/.env (voir config.py).
#
# Génération clés VAPID : python scripts/generate_vapid_keys.py
# Broker MQTT local   : docker compose up -d  (depuis back/)
# =============================================================================

# --- Auth0 (validation JWT) ---
# Domaine du tenant Auth0 (sans https://)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# Identifiant de l'API Auth0 (audience des tokens)
AUTH0_AUDIENCE=https://your-api-identifier
# Claim JWT contenant le rôle (défaut dans config.py : https://vitalio.app/role)
# AUTH0_ROLE_CLAIM=https://vitalio.app/role

# Auth0 Management API (M2M) - création d'utilisateurs côté serveur (optionnel)
# AUTH0_M2M_CLIENT_ID=
# AUTH0_M2M_CLIENT_SECRET=

# --- MongoDB ---
# URI de connexion (Atlas : mongodb+srv://... ; local : mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Base identité (users, liens médecin/patient, devices)
MONGODB_IDENTITY_DB=Vitalio_Identity
# Base médicale (mesures, alertes, ML)
MONGODB_MEDICAL_DB=Vitalio_Medical
# Résolveurs DNS explicites pour mongodb+srv (Windows / DNS LAN instables). Ex. : 8.8.8.8,1.1.1.1
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# --- MQTT (TLS port 8883) ---
# Local Mosquitto :
MQTT_BROKER=localhost
MQTT_PORT=8883
# HiveMQ Cloud (prod) :
# MQTT_BROKER=your-cluster.s1.eu.hivemq.cloud
# MQTT_CA_CERT=certifi
# Topic d'écoute (wildcards + pour tous les devices)
# MQTT_TOPIC=vitalio/dev/+/measurements
MQTT_USERNAME=vitalio
MQTT_PASSWORD=change-me
# CA TLS : ./mosquitto/certs/ca.crt (Mosquitto local) ou certifi (HiveMQ / Let's Encrypt)
MQTT_CA_CERT=./mosquitto/certs/ca.crt
# Désactiver l'abonnement MQTT au démarrage de l'API (ex. Render sans broker)
# MQTT_ENABLED=false

# --- Simulateur IoT (data.py) ---
# Identifiant device publié dans le topic vitalio/dev/{DEVICE_ID}/measurements
DEVICE_ID=SIM-ESP32-001
# Nom de la collection mesures (utilisé par data.py)
# MONGODB_MEASUREMENTS_COLLECTION=measurements
# Écriture directe MongoDB depuis le simulateur (true/false)
# MONGODB_DIRECT_WRITE_ENABLED=true

# --- Scripts seed (seed_db.py, développement) ---
# Sub Auth0 du patient de test + device associé
# SEED_USER_ID_AUTH=auth0|xxxxxxxx
# SEED_DEVICE_ID=SIM-ESP32-001

# --- Invitations médecin / aidant ---
# Durée de validité des liens d'invitation (heures)
# INVITE_TTL_HOURS=24
# Durée de validité des codes cabinet (minutes)
# CABINET_CODE_TTL_MINUTES=15

# --- Email (Mailjet API HTTPS) - invitations et alertes ---
# Render bloque SMTP (ports 587/465) : l'API utilise HTTPS (api.mailjet.com).
# SMTP_USER     = Mailjet API Key (publique)
# SMTP_PASSWORD = Mailjet Secret Key
SMTP_USER=your-mailjet-api-key
SMTP_PASSWORD=your-mailjet-secret-key
EMAIL_FROM=noreply@example.com
# Legacy (non utilisé par l'API HTTP Mailjet, conservé pour compatibilité .env)
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587

# --- Frontend & CORS ---
# URL publique du front (liens dans les e-mails, CORS)
FRONTEND_URL=http://localhost:5173
# Origines CORS supplémentaires, séparées par des virgules (previews Vercel, etc.)
# CORS_ORIGINS=https://vitalio-preview.vercel.app

# --- Web Push (notifications navigateur médecin/aidant) ---
# Clé publique VAPID (base64url)
VAPID_PUBLIC_KEY=
# Clé privée : chemin vers un fichier PEM ou contenu PEM (relatif à back/)
VAPID_PRIVATE_KEY=vapid_private.pem

# --- Chiffrement applicatif (profils : téléphone, adresse, historique médical) ---
# Générer : python scripts/generate_field_encryption_key.py
FIELD_ENCRYPTION_KEY=

# --- Serveur Flask (développement local) ---
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# FLASK_DEBUG=false
