# =============================================================================
# Vitalio — Frontend (React + Vite)
# =============================================================================
# Copier ce fichier vers front/vitalio/.env
# Variables exposées au navigateur : préfixe VITE_ obligatoire.
#
# En production (Vercel) : configurer les mêmes variables dans le dashboard
# Vercel → Settings → Environment Variables.
# =============================================================================

# --- Auth0 (Single Page Application) ---
# Domaine du tenant Auth0
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
# Client ID de l'application SPA Auth0
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Audience de l'API (identique à AUTH0_AUDIENCE côté backend)
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# --- API backend ---
# URL de l'API Flask (local ou Render en production)
VITE_API_URL=http://localhost:5000
