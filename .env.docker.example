# Variables pour docker compose (substitution ${VAR} au build et au run).
# Copier vers .env à la racine du dépôt :  copy .env.docker.example .env
#
# Les secrets backend peuvent rester dans back/.env (env_file du service api).
# Les variables VITE_* doivent être ici pour le build du front.

# --- Frontend (build-time Vite) ---
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
# URL de l'API vue par le navigateur (port exposé sur l'hôte)
VITE_API_URL=http://localhost:5000
